  "calculation_formula": {
    "cumulative_net_rental_income": "net_rental_income_aed * holding_period_months / 12",
    "capital_return": "net_sale_proceeds_aed - total_cash_invested_aed",
    "total_return": "cumulative_net_rental_income_aed + capital_return_aed",
    "full_property_roi_pct": "total_return_aed / total_cash_invested_aed * 100",
    "identity_form1": "cumulative_rental + capital_return",
    "identity_form2": "cumulative_rental + net_sale_proceeds - total_cash_invested"
  },

  "readiness_gate": {
    "required_conditions": [
      "property_status = Ready",
